{
  "name": "spor-defterim-pwa",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --no-tunnel",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "tsc -b && vite build",
    "android:sync": "npm run build && npx cap sync android && node -e \"try{require('fs').rmSync('android/app/src/main/assets/public/GymPad.apk',{force:true})}catch(e){}\"",
    "android:open": "npx cap open android",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "^8.7.5",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.18.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.0"
  }
}
